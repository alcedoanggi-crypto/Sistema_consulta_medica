DATABASE_URL=postgresql://mediagenda:mediagenda_dev@127.0.0.1:5435/mediagenda
# Clave de cifrado pgcrypto: vive solo en el servidor de aplicación, nunca en la BD
CLAVE_CIFRADO=cambia-esta-clave-larga-y-aleatoria
JWT_SECRET=cambia-este-secreto
PUBLIC_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5200
CLINICA_NOMBRE=MediAgenda · Centro Médico
# Correo (si SMTP_HOST está vacío, los recordatorios se guardan como .eml en backend/outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=recordatorios@mediagenda.local
# WhatsApp opcional: URL del módulo de mensajería (POST {telefono, mensaje})
WHATSAPP_API_URL=
